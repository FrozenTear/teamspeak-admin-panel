# Contabo soft CPU pin for ts6-manager-fullstack.
# Re-applied after every `podman kube play` / `./scripts/update.sh` by
# scripts/apply-fullstack-soft-pin.sh — kube YAML does not persist
# HostConfig CpusetCpus or process nice across down+play.
#
# Values match the overnight A/B win on Contabo (rootful kube, not Quadlet):
# CpusetCpus=2-5, nice -5. Floki and other hosts: omit this file, empty
# the values below, or point TS6_SOFT_PIN_ENV at a host-local override.
# Do not copy these pins blindly.
#
# Sidecar stays unpinned unless TS6_SIDECAR_CPUSET / TS6_SIDECAR_NICE
# are set (default off).

TS6_FULLSTACK_CPUSET=2-5
TS6_FULLSTACK_NICE=-5

# TS6_SIDECAR_CPUSET=
# TS6_SIDECAR_NICE=
