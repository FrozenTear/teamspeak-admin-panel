# TS6 Manager — operator env file template.
#
# Copy to: $XDG_CONFIG_HOME/containers/systemd/ts6-manager.env
# (typically  ~/.config/containers/systemd/ts6-manager.env )
#
# Chmod 0600 — this file holds the JWT signing key and the at-rest
# encryption key. Never commit a populated copy.

# ─── REQUIRED ──────────────────────────────────────────────────────────
# JWT signing secret. The server refuses to boot with NODE_ENV=production
# unless this is set to a non-placeholder value of ≥ 32 bytes of entropy.
# Generate: openssl rand -base64 48
JWT_SECRET=

# ─── RECOMMENDED ───────────────────────────────────────────────────────
# AES-256-GCM key for at-rest secret encryption (TS server-connection
# credentials, SSH host-key fingerprints, etc.). If unset the server
# falls back to deriving the key from JWT_SECRET — workable but means
# both secrets rotate together. Generate: openssl rand -base64 32
# ENCRYPTION_KEY=

# Public origin the browser hits the UI on. Used for CORS + cookie
# domain. Defaults to http://localhost:3000 in production mode.
# FRONTEND_URL=https://ts6.example.org

# Fullstack listener bind address (PURA-197). Default 0.0.0.0 — the
# PublishPort=127.0.0.1:3001:3001 line in ts6-manager.pod is what keeps
# the listener off the LAN by default. If you flip the pod to
# `Network=host` (e.g. so the manager's WebQuery client can reach a
# loopback TS6 server without going through passt — see PURA-105 / PURA-188),
# set this to 127.0.0.1 so the listener stays loopback-only.
# HOST=127.0.0.1

# ─── OPTIONAL TUNING ──────────────────────────────────────────────────
# Log verbosity (trace, debug, info, warn, error). Default: info.
# LOG_LEVEL=info

# Set to 1 for pretty-printed logs (dev only — prod stays JSON).
# LOG_PRETTY=1

# Number of trusted reverse-proxy hops in front of the listener
# (spec §6.8). 0 = direct exposure (ignore X-Forwarded-For and
# X-Forwarded-Proto). 1 = exactly one trusted proxy, but only when
# the TCP peer is inside TRUSTED_PROXY_CIDRS. Empty CIDRs (the
# default) never trust forwarding headers, even if hops is 1.
# HSTS is emitted only for a trusted X-Forwarded-Proto: https.
# An absolute-form request URI is not enough. Bare :3001 must not
# send HSTS — that trains browsers to demand TLS on a port with no cert.
# Pair hops=1 with the proxy's peer CIDR (Caddy on loopback is
# 127.0.0.1/32), or keep :3001 unreachable except from that proxy.
# TRUSTED_PROXY_HOPS=0
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# JWT lifetimes (15m / 7d / 30s / 2h syntax, or bare seconds).
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d

# ─── SIDECAR (Phase 5 VIDEO) ──────────────────────────────────────────
# Manager → sidecar HTTP control plane URL. When set, the manager
# routes video-source RPCs through it. Disable to hide the video UI.
# Port 7080 matches the sidecar `--http-listen` default, Containerfile
# EXPOSE, and deploy/kube. Historical spec default 9800 is not used.
# SIDECAR_URL=http://127.0.0.1:7080

# ─── MUSIC RUNTIME (split send loop) ──────────────────────────────────
# When set, fullstack does not spawn a Voice send loop. It proxies
# lifecycle, play, now-playing, rehydrate, and the SSE event stream to
# ts6-manager-music. Loopback single-box deploys leave this unset.
# MUSIC_RUNTIME_URL=http://127.0.0.1:3002

# Optional shared bearer for that control API. Read from the environment
# only (not a file, the database, or a CLI flag). Empty or whitespace is
# unset. Both the fullstack process and the music process must be given
# the same value. Unset on loopback: the music API stays open and
# fullstack sends no Authorization header. When set, fullstack sends
# Authorization: Bearer on every runtime call. A runtime 401 is returned
# to the browser as 502 {"error":"music_runtime_auth"}. Do not log it.
# Generate: openssl rand -base64 32
# MUSIC_RUNTIME_TOKEN=

# Publicly-reachable WebTransport endpoint advertised to the widget
# viewer (PURA-146). Must terminate TLS — browsers reject WebTransport
# on cleartext origins. Leave unset to show "No live video".
# MOQ_PUBLIC_URL=https://moq.example.org

# ─── YOUTUBE COOKIE FILE (music bot, PURA-216) ────────────────────────
# Path to a Netscape `cookies.txt` for yt-dlp to authenticate against
# YouTube. Needed for age-gated, region-locked, and "confirm you're not
# a bot" rate-limited videos. Generate via the cookies.txt Firefox add-on
# while logged into youtube.com. File must be readable by uid 10001
# (the `ts6` user inside the fullstack image). When set, every yt-dlp
# invocation runs with `--cookies <path>`; unset = no flag, anonymous.
# Operator change requires manager restart; UI-managed upload is a
# follow-up ticket.
# YT_COOKIE_FILE=/var/lib/ts6-manager/cookies/youtube.txt

# ─── SSH BRIDGE (Phase 2 control-path) ────────────────────────────────
# Path to a shared OpenSSH known_hosts file. Empty/unset falls back to
# per-row fingerprint pinning.
# TS_SSH_KNOWN_HOSTS=/var/lib/ts6-manager/known_hosts

# Trust-on-first-use for SSH host keys (PURA-100). MitM-exposed on the
# first connect — pin the fingerprint out-of-band instead when possible.
# TS_SSH_TOFU=0

# Accept self-signed certificates on upstream TS WebQuery connections.
# Dev/lab only.
# TS_ALLOW_SELF_SIGNED=0

# ─── WIDGET RATE LIMITS (PURA-72 Slice F) ─────────────────────────────
# Per-token + per-IP request budgets (req/min) for /api/widget/*.
# WIDGET_RATE_LIMIT_PER_TOKEN_PER_MINUTE=30
# WIDGET_RATE_LIMIT_PER_IP_PER_MINUTE=30
